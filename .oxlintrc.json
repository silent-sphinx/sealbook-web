{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // oxlint rather than ESLint because this project is on TypeScript 7, and
  // typescript-eslint peers on `typescript <6.1.0`: installing it needs
  // --legacy-peer-deps, which would weaken resolution for every other
  // dependency too. oxlint parses TypeScript itself and has no such peer.
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["src/pkg/**", "dist/**"],
  "settings": {
    "jsx-a11y": {
      // PasswordField renders an input and forwards every prop to it, so the
      // a11y rules can reason about it as one. Without this a label wrapping
      // it reads as a label wrapping nothing.
      "components": {
        "PasswordField": "input"
      }
    }
  },
  "rules": {
    // Off: each of these fights a pattern this codebase uses on purpose.
    //
    // `ref.current` is assigned during render in Modal, NotesView and
    // NoteEditor so a queued callback closes over the current props while the
    // effect that owns it is created once. Each site says so.
    "react/refs": "off",
    "react/purity": "off",
    // Flags locals reassigned inside effects and handlers, such as an effect's
    // `cancelled` flag or an id captured across an `await`, which never feed
    // a render.
    "react/immutability": "off",
    // Modal's focus trap looks for `[autofocus]` inside the panel to decide
    // where to put the caret, so the attribute is load-bearing here.
    "jsx-a11y/no-autofocus": "off",
    // The radio and status roles sit on styled elements that cannot be an
    // `input` or an `output` without losing the styling they exist for.
    "jsx-a11y/prefer-tag-over-role": "off",
    // Deliberate preallocation on the base64 path in `bytes.ts`.
    "unicorn/no-new-array": "off",
    // Several suites assert through helpers that take the expectation with
    // them, which this rule cannot see into.
    "vitest/expect-expect": "off",

    // The jsx-a11y set is clean, so it gates as an error through the
    // correctness category above. These two keep an override only to carry
    // their options.
    //
    // depth 3, not the default 2: the delete-choice radios put their text in
    // a nested span pair, which a browser still reads as the label's text.
    "jsx-a11y/label-has-associated-control": ["error", { "depth": 3 }],
    // A datalist option carries its text in `value`, and the mailto/tel rows in
    // ContactDetailModal name themselves from descendant text one level below
    // the default search depth. `ignoreElements` restates the rule's own
    // defaults, which supplying the list replaces.
    "jsx-a11y/control-has-associated-label": [
      "error",
      {
        "depth": 3,
        "ignoreElements": [
          "audio",
          "canvas",
          "datalist",
          "embed",
          "input",
          "option",
          "textarea",
          "tr",
          "video"
        ]
      }
    ],

    // Warn: what is left of the backlog, surfaced on every run but not
    // blocking. Flip each to "error" as it is cleared, and add
    // --max-warnings 0 to the lint script once the last one is gone.
    //
    // Usually a prop-to-state sync, which is legitimate, but it is also how a
    // cascading-render bug looks, so it stays visible.
    "react/set-state-in-effect": "warn",
    "vitest/require-to-throw-message": "warn",
    "vitest/require-mock-type-parameters": "warn"
  }
}
